// =============================================================================
// OSHAL Headscale HARDENED ACL Policy (deny-by-default, tag-segmented)
// =============================================================================
// CHANGE LOG
// -----------------------------------------------------------------------------
// 1 | maintainer@emeraldcoastsystemsgroup.com   | Replaces the wide-open starter policy (src:* dst:*:*)
//            | with a deny-by-default tag policy: workers can reach ONLY the controller's
//            | API port, never the datastores or each other. Staged here (not auto-applied)
//            | so it can be reviewed + swapped in deliberately:
//            |   cp policy.hardened.hujson policy.hujson   # then
//            |   headscale policy set -f /etc/headscale/policy.hujson
// 2 | maintainer@emeraldcoastsystemsgroup.com   | Made the staged policy apply-ready:
//            | tagOwners now use the real Headscale user (agentmesh, created by
//            | scripts/headscale-setup.sh) instead of the the operator@ placeholder; the 5000
//            | placeholder ports replaced with the real tailnet-facing ports (controller API
//            | is host-published on 35457, edge-agent bot-node listens on 3099 per
//            | scripts/start-local-agent.bat); added the datastore ports the edge agent
//            | dials TODAY (Redis 6379 / Postgres 5432 / ChromaDB 8000) so applying this
//            | policy does not brick the running edge agent; corrected the provisioning
//            | comment that referenced a never-built controller enroll route — worker keys
//            | are minted host-side by scripts/headscale-enroll-worker.sh.
// =============================================================================
//
// PROVISIONING: enrolled nodes must carry a tag. Mint worker keys with
//   scripts/headscale-enroll-worker.sh — it creates a single-use EPHEMERAL pre-auth key
//   already pre-tagged tag:worker (1h expiry), so a freshly-onboarded machine is
//   automatically scoped by the rules below and its node record vanishes on disconnect.
//   Admin/controller machines are tagged after the fact by an operator:
//     headscale nodes tag -i <id> -t tag:admin      (or tag:controller)
//   Ephemeral keys are for WORKERS ONLY — an admin/controller node enrolled ephemerally
//   would drop out of the mesh (and lose its tag) on every disconnect.
//
// APPLY (operator, on the headscale host):
//   1. Tag every live node (headscale nodes list; then nodes tag -i <id> -t tag:...).
//   2. cp policy.hardened.hujson policy.hujson
//   3. docker exec oshal-headscale headscale policy set -f /etc/headscale/policy.hujson
//   4. Re-verify the edge agent still reaches the swarm (see
//      docs/runbooks/headscale-acl-hardening.md).

{
  // Who may assign each tag (only the mesh user minted by headscale-setup.sh).
  "tagOwners": {
    "tag:admin":      ["agentmesh@"],
    "tag:controller": ["agentmesh@"],
    "tag:worker":     ["agentmesh@"],
  },

  // Deny-by-default: any src->dst not matched below is dropped.
  "acls": [
    // Admin machines run the mesh — full access.
    { "action": "accept", "src": ["tag:admin"], "dst": ["*:*"] },

    // Workers may reach the controller's API (host-published port 35457 — workers dial the
    // swarm host across the tailnet, and the api container publishes 5000 as 35457 there).
    { "action": "accept", "src": ["tag:worker"], "dst": ["tag:controller:35457"] },

    // TRADE-OFF (deliberate, documented): the edge agent (scripts/start-local-agent.bat)
    // still dials the datastores DIRECTLY over the tailnet — Redis 6379, Postgres 5432,
    // ChromaDB 8000. Until that agent is migrated to API-only access (tracked in
    // docs/backlog/hardening.md #15), these ports must stay worker-reachable or applying
    // this policy bricks the edge agent mid-flight. This is still a large cut from the
    // allow-all starter policy: no Arango, no Docker socket, no code-server, no
    // worker-to-worker traffic. Tighten by deleting these three rules once the edge agent
    // is API-only.
    { "action": "accept", "src": ["tag:worker"], "dst": ["tag:controller:6379"] },
    { "action": "accept", "src": ["tag:worker"], "dst": ["tag:controller:5432"] },
    { "action": "accept", "src": ["tag:worker"], "dst": ["tag:controller:8000"] },

    // The controller may dispatch back to a worker's edge-agent API port
    // (PORT=3099 in scripts/start-local-agent.bat).
    { "action": "accept", "src": ["tag:controller"], "dst": ["tag:worker:3099"] },

    // (Everything else: implicitly denied — workers cannot see each other at all.)
  ],

  // No tailnet SSH allowed by default. Add explicit rules here only if you use `tailscale ssh`.
  "ssh": [],
}
