# =============================================================================
# OSHAL Kubernetes deployment env example
# =============================================================================
# CHANGE LOG
# -----------------------------------------------------------------------------
# SEQ                 | AUTHOR                      | DESCRIPTION
# -----------------------------------------------------------------------------
# 1 | maintainer@emeraldcoastsystemsgroup.com   | Added environment template for the OSHAL Kubernetes setup helper
# =============================================================================

# -----------------------------------------------------------------------------
# Required values
# -----------------------------------------------------------------------------
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=replace-me

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=replace-me
KEYCLOAK_CLIENT_SECRET=replace-me
SESSION_SECRET=replace-with-a-long-random-session-secret

APP_URL=https://oshal.example.com
KEYCLOAK_EXTERNAL_URL=https://sso.example.com

# -----------------------------------------------------------------------------
# Optional values
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
PRESENTRON_API_KEY=

MOCK_OIDC=false
KEYCLOAK_REALM=oshal
KEYCLOAK_CLIENT_ID=oshal-swarm
LLM_MODEL=claude-sonnet-4-5-20250929
LOG_LEVEL=info
OPENAI_CODEX_CALLBACK_PORT=1455
PRESENTRON_ENDPOINT=http://presentron:8080
RAG_INGESTION_ENDPOINT=
SWARM_MODE=single
IMAGE_PULL_POLICY=IfNotPresent
INCLUDE_BOOTSTRAP_DEV_USERS=false
