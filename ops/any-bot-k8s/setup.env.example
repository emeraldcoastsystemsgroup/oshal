# any-bot-k8s setup script example values
# Copy this file and replace every placeholder before running the setup script.

POSTGRES_DB=oshal
POSTGRES_USER=oshal_user
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
REDIS_URL=redis://redis:6379
ANTHROPIC_API_KEY=
PRESENTRON_API_KEY=
KEYCLOAK_CLIENT_SECRET=
APP_URL=http://localhost:3456
MOCK_OIDC=true
TS_AUTHKEY=replace-with-headscale-preauth-key
HEADSCALE_LOGIN_SERVER=https://headscale.example.com
GOOGLE_SEARCH_MCP_URL=http://google-search-mcp:8080/mcp

# Optional overrides
# IMAGE_TAG=oshal-api-server:latest
# GOOGLE_SEARCH_MCP_IMAGE=supercorp/supergateway:latest
# APPLY_MANIFESTS=false
# SKIP_IMAGE_BUILD=false
