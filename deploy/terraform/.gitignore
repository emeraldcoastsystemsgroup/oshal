# Terraform local state + workdir — never committed (state can embed secret values).
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# Root-level tfvars are where real secrets land — only envs/*.tfvars (reviewed,
# placeholder-only) are versioned.
terraform.tfvars
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
