# AZURE_EMAIL_APPLICATION_ID=        # tolerated alias: AZURE_EMAIL_APPLICCATION_ID
# AZURE_EMAIL_CLIENT_SECRET=         # tolerated alias: OUTLOOK_CLIENT_VALUE (read first)
# OUTLOOK_CLIENT_SECRET=             # the secret's GUID id, not the value
# AZURE_EMAIL_TENANT=common
# AZURE_EMAIL_DIRECTORY_ID=common
# OUTLOOK_TENANT_ID=common
# OUTLOOK_REDIRECT_URI=
