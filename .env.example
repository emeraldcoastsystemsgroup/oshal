#   ${APP_URL}/api/hooks/github/issues
# Content type application/json, event "Issues", and the same random secret below.
# GITHUB_WEBHOOK_SECRET=
# Optional free REST reconciliation (no Actions job): fine-grained read-only token for
# the three private issue repositories. Leave empty when webhook-only operation is desired.
# GITHUB_TICKET_TOKEN=
# Optional issue-comment credential. Keep separate from the read-only pull token;
# OSHAL never uses this to close an issue.
# GITHUB_TICKET_WRITEBACK_TOKEN=
# Optional JSON feed override; defaults map oshal-applications, open-shal, and oshal as documented.
# GITHUB_TICKET_FEEDS=

