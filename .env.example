# #############################################################################
# READ THIS FIRST
# #############################################################################
#
# You do NOT need to fill any of this in to try Open Swarm.
#
#   The default install runs with FORCE_LLM_PROVIDER=noop and MOCK_OIDC=true.
#   Zero keys, zero accounts, zero identity provider. Everything below is how
#   you turn on *real* models and *real* connectors, one at a time.
#
# THREE TIERS. Know which one you are in.
#
#   1. TRY IT      — change nothing. `Install-OpenSwarm.bat`, or
#                    `bash scripts/install.sh`. Bots reply deterministically
#                    via the `noop` harness. Nothing costs money.
#
#   2. REAL MODELS — sign in through the cockpit (Settings -> Provider) with
#                    your own Claude/ChatGPT account, OR set one API key below.
#                    Bring-your-own-key: no vendor key is ever baked into an
#                    image or a bot's environment.
#
#   3. REAL DEPLOY — you are exposing this to other people. Now the secrets in
#                    "MUST CHANGE BEFORE ANYONE ELSE CAN REACH THIS" matter.
#                    They have dev-friendly fallbacks that are safe on your
#                    laptop and dangerous anywhere else.
#
# HOW TO READ THIS FILE
#
#   Commented-out (`# FOO=`) means: unset is a valid, working default.
#   Uncommented with a value means: that value is a sane default to keep.
#   Uncommented and empty (`FOO=`) means: a feature stays OFF until you set it.
#
# A NOTE ON MISSPELLED NAMES
#
#   Some variables below are documented under a misspelled alias
#   (X_CLIENT_SECRECT, SLACK_CLINET_ID, AZURE_EMAIL_APPLICCATION_ID,
#   ALPAKA_*). Those typos are load-bearing — src/app/routes/connectors-routes.ts
#   reads them as fallbacks and a live .env depends on them. Always prefer the
#   correctly-spelled name; the alias is listed only so you can recognise it.
#
# #############################################################################

# =============================================================================
# API Configuration Server - Environment Settings
# =============================================================================

# Directory where configuration files will be written
# Can be an absolute path or relative to the project root
CONFIG_OUTPUT_DIR=./output

# Write mode for configuration files:
#   "split"   - Writes to 3 separate files: global-config.json, cline-config.json, secrets.json
#   "unified" - Writes everything to a single config.json file
CONFIG_WRITE_MODE=split

# Authentication API key (optional)
# When set, all /api/* routes require Authorization: Bearer <key> header
# When not set, authentication is disabled (open access)
# AUTH_API_KEY=your-secret-key-here

# Server port
PORT=3456

# Cockpit profile (which surfaces the left ribbon shows on first load).
#   oshal-starter   - clean first-run cockpit (Jarvis + Bot Forge + Explore Apps). Default.
#   oshal-framework - full operator cockpit with every app surface grouped.
# This is presentation only; it never disables backend routes/bots/apps. You can
# also switch per-visit with ?profile=<name> on the cockpit URL.
UI_PROFILE=oshal-starter

# -----------------------------------------------------------------------------
# Cline CLI / Claude Code provider integration
# -----------------------------------------------------------------------------
# Leave EMPTY unless you are pasting a real key. A placeholder string here is
# sent to Anthropic verbatim and comes back as a confusing 401.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
SWARM_MODE=single

# -----------------------------------------------------------------------------
# Multi-harness execution
# -----------------------------------------------------------------------------
# SWARM_REGISTRY selects the active bot lineup. The default (and 'local') is the lean
# LOCAL_BOT_REGISTRY (swarm-bot-registry-local.ts), which declares harnessType + apiType
# per bot — required for multi-harness routing. Set SWARM_REGISTRY=full to opt into the
# fuller SWARM_BOT_REGISTRY. The oshal-local docker-compose sets this automatically.
SWARM_REGISTRY=local

# Override the process-level LLM provider (bypasses global-config.json).
# `noop` is the zero-keys harness the default install uses: bots answer
# deterministically, nothing costs money, no account needed. Switch to a real
# provider ('openai-codex', 'claude-code', 'ollama', ...) once you
# have signed in through the cockpit or set a key above.
FORCE_LLM_PROVIDER=noop
FORCE_LLM_MODEL=claude-sonnet-4-6

# Running without a connected model on purpose? DECLARE it (INSTALLER-GAPS G2/G3).
# With OSHAL_NO_AI=true the onboarding gate and GET /api/readiness treat "no model"
# as a chosen posture (AI features disabled) instead of a broken engine. Without it,
# a noop/model-less box FAILS scripts/oshal-verify.sh and keeps redirecting users to
# /welcome — DISABLE_ONBOARDING_GATE alone no longer waives the model requirement.
# oshal-install.sh --no-ai writes this for you.
#OSHAL_NO_AI=true

# Vendor-CLI credential mount modes (INSTALLER-GAPS G4). Default ro suits a dev box
# with its own host-side token refresh. On a SERVER set both to rw: the in-container
# CLI must be able to write its credential file to refresh the OAuth token — mounted
# ro, `claude auth login` reports success while saving nothing, and the login dies at
# the first refresh. oshal-install.sh writes rw for server installs.
#CLAUDE_AUTH_MOUNT_MODE=rw
#GEMINI_AUTH_MOUNT_MODE=rw

# Codex has one live, rotating native auth.json. Local compose pins the in-container
# target to /root/.codex/auth.json and mounts CODEX_CONFIG_HOST_PATH there. Keep the
# target explicit on controller deployments so a web-triggered operator promotion
# cannot discover or overwrite an unrelated login through a HOME fallback.
#CODEX_CONFIG_HOST_PATH=~/.codex
#CODEX_AUTH_SOURCE_PATH=/root/.codex/auth.json

# Model used by the claude-code harness (code-reviewer bot).
# Must be a valid Anthropic model accessible via the Claude Code CLI.
CLAUDE_CODE_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# Application store (Discover shelf + `oshal-app.js install`)
# -----------------------------------------------------------------------------
# Both default to the PUBLIC store, which is also what scripts/oshal-install.sh
# downloads — leave them unset and installs work anonymously.
#
# Set these two ONLY on a box that should read the private application trunk (the
# maintainer's own dev box, a customer box entitled to unpublished packages). A
# store repo that the token cannot read degrades honestly: GET /api/swarm/apps/catalog
# returns available:false with a reason, never an error loop.
#OSHAL_STORE_REPO=https://github.com/emeraldcoastsystemsgroup/oshal-applications
#OSHAL_STORE_TOKEN=ghp_your_token_with_read_access
# Branch/tag the catalog is read from (default main).
#OSHAL_STORE_REF=main
# Package audits are structurally mandatory in both modes. `compatible` (default)
# permits a valid pending/failed record with an explicit NOT VERIFIED warning and no
# audit SHA pin. `enforce` installs/updates only a passed record whose six controls and
# hashed evidence bind the exact app/version/source SHA, then checks out that SHA.
OSHAL_PACKAGE_AUDIT_MODE=compatible

# -----------------------------------------------------------------------------
# Redis scheduler (self-scheduling)
# -----------------------------------------------------------------------------
# Redis connection used by /api/v1/agent schedule APIs and scheduler runner
REDIS_URL=redis://localhost:6379
# Set to 'false' to disable background schedule polling on API startup
ENABLE_AGENT_SCHEDULER=true
# Poll interval for due schedule dispatch
SCHEDULER_POLL_INTERVAL_MS=15000

# -----------------------------------------------------------------------------
# Mock OIDC (local development without Keycloak)
# -----------------------------------------------------------------------------
# Set to 'true' to bypass real OIDC authentication with a fake dev user.
# When enabled, no Keycloak instance is required. Never use in production.
# MOCK_OIDC=true

# -----------------------------------------------------------------------------
# Local invited-user login (LOCAL_AUTH, ADR-117) — client boxes with no IdP
# -----------------------------------------------------------------------------
# Set to 'true' for a CONTROLLED first-party login: only invited accounts can
# sign in. An admin invites a user by email; the one-time link (7-day expiry)
# lets them set a password. The first account created on a fresh install is the
# administrator (add its email to OSHAL_OPERATOR_EMAILS for platform-admin API
# access). Mutually exclusive with MOCK_OIDC — the server refuses to boot with
# both. REQUIRES SESSION_SECRET (signs the oshal_local session cookie).
# LOCAL_AUTH=true
# Existing LOCAL_AUTH customer boxes may pilot tenant-specific Microsoft sign-in without
# removing the password door. This is explicit and per deployment: HYBRID keeps
# LOCAL_AUTH=true and the invited-user form at /login, adds "Continue with Microsoft"
# through /login/microsoft, and retains /login/local as recovery. It reuses
# MICROSOFT_TENANT_ID + MICROSOFT_OIDC_CLIENT_ID/SECRET and the exact
# https://<host>/callback/microsoft Web redirect. The bridge maps a verified tenant
# identity only onto an existing ACTIVE or INVITED local account; first SSO acceptance is
# atomic but preserves its one-time password invite as a rollback rail. The email allowlist
# gates only the first link; a durable link remains valid if that email is later removed. Unprovisioned
# identities fail closed. The HYBRID flag implies the bridge; leave the standalone BRIDGE
# flag false during the pilot (it is for a later LOCAL_AUTH=false cutover). Leave both flags
# unset/false everywhere else.
# ENTRA_LOCAL_IDENTITY_BRIDGE=false
# ENTRA_LOCAL_AUTH_HYBRID=false
# ENTRA_LOCAL_IDENTITY_EMAILS=      # required allowlist for first-time links; comma-separated
# Absolute origin used in emailed invite links (falls back to APP_URL). The
# admin API always returns a copyable invite link too, so email is optional.
# LOCAL_AUTH_PUBLIC_URL=https://crm.example.com

# Transactional mail for invitations. TWO RAILS, tried in order:
#   1. SMTP below — only when this deployment has its OWN mail server.
#   2. The platform's Gmail connector — the same OAuth grant every other outbound
#      message uses. Connect a Google account once on the Connectors screen; the
#      sender is NOTIFY_EMAIL_SENDER_SUB, else the first OSHAL_OPERATOR_SUBS entry.
#      This is the default path: a box needs NO mail password.
# Neither available? The invitation is still created and the admin screen shows a
# copyable one-time link — a working state, not a failure.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false          # 'true' for implicit TLS (port 465)
# SMTP_FROM=                 # defaults to SMTP_USER

# -----------------------------------------------------------------------------
# OIDC / Keycloak Integration (ignored when MOCK_OIDC=true)
# -----------------------------------------------------------------------------
# For local development (API server running on host):
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=oshal
KEYCLOAK_CLIENT_ID=oshal-swarm
# Required when MOCK_OIDC is false. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-session-secret

# Jarvis deterministic speaker diarization (ADR-084). Use a separate random
# value in non-local deployments; it authenticates oshal-api to the private
# sherpa-onnx sidecar and is never sent to browsers.
SPEAKER_SERVICE_KEY=replace-with-a-separate-random-speaker-service-key
# Controller-only encryption root for derived biometric templates. Do not reuse
# the sidecar credential and do not expose this to worker-bot containers.
SPEAKER_PROFILE_SECRET=replace-with-a-separate-random-speaker-profile-secret
# During a controlled rotation, set this to the former profile secret. Profile
# reads durably rewrap old key-id envelopes with SPEAKER_PROFILE_SECRET. Remove
# PREVIOUS only after every owner has loaded Voice & Speakers and a DB key-id
# audit confirms no legacy/previous prefixes remain.
SPEAKER_PROFILE_SECRET_PREVIOUS=
SPEAKER_DIARIZATION_URL=http://speaker-diarization:8080
# Comma-separated Host values accepted by the private sidecar. Wildcards, URLs,
# paths, whitespace, and an empty list fail validation; never expose this service publicly.
SPEAKER_ALLOWED_HOSTS=127.0.0.1,localhost,speaker-diarization
SPEAKER_DIARIZATION_TIMEOUT_MS=45000
SPEAKER_MAX_DURATION_SECONDS=58
SPEAKER_STT_TIMEOUT_MS=55000
# Controller admission limits: one active upload per owner, 1-4 globally, and
# 3-60 accepted uploads per owner/minute (defaults shown).
SPEAKER_MAX_ACTIVE_UPLOADS=1
SPEAKER_MAX_UPLOADS_PER_OWNER_MINUTE=12
# Audio receipt/observation idempotency window. TTL is bounded 1-168 hours and
# the owner cap 1000-20000. The 120-1800s lease must exceed worst-case bounded
# sidecar + cloud-STT + persistence time; ambient is sidecar-first to skip STT silence.
SPEAKER_AUDIO_RECEIPT_TTL_HOURS=48
SPEAKER_AUDIO_RECEIPT_LIMIT=10000
SPEAKER_AUDIO_LEASE_SECONDS=300
# The cockpit's own URL. The docker install serves it on 35457, not the legacy 3456.
APP_URL=http://localhost:35457

# -----------------------------------------------------------------------------
# SmartThings OAuth-In connector
# -----------------------------------------------------------------------------
# Create with SmartThings CLI: smartthings apps:create -> OAuth-In App.
# Register this redirect URI, or override it with SMARTTHINGS_REDIRECT_URI:
#   ${APP_URL}/api/connect/smartthings/callback
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_SCOPES=r:devices:* x:devices:* r:scenes:* x:scenes:* r:locations:*
# SMARTTHINGS_REDIRECT_URI=https://oshal.example.com/api/connect/smartthings/callback

# -----------------------------------------------------------------------------
# Finance aggregation app (?app=finance, ADR-048)
# -----------------------------------------------------------------------------
# Read-only money aggregation: Plaid links the user's banks + brokerages, the
# finance-analyst bot reasons over the aggregate (net worth, holdings, spend).
# Plaid does NOT use redirect OAuth — it uses Plaid Link (or, on localhost, a
# Sandbox demo-connect button). The ?app=finance surface shows a setup note
# until BOTH keys below are set.
#
# Get free Sandbox keys instantly: dashboard.plaid.com → Team Settings → Keys
# (client_id + the "Sandbox" secret). Sandbox = fake banks, no real data, no
# approval needed — perfect for testing the whole flow end-to-end.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Optional: override the demo-connect Sandbox institution (default ins_109508 = First Platypus Bank)
# PLAID_SANDBOX_INSTITUTION=

# Money movement (POST /api/finance/pay). The finance app can move the user's money
# (ACH debit of their own linked bank) through a provider-agnostic PaymentAdapter.
# PAYMENT_PROVIDER selects the rail — 'stripe' is built; 'plaid-transfer'/'dwolla' are
# planned siblings. The Pay panel stays disabled until the rail's credentials are set.
#
# Stripe: use a TEST secret key (sk_test_…) for safe end-to-end testing — fake banks,
# no real money. Get it at dashboard.stripe.com → Developers → API keys.
# isTestMode() keys off the sk_test_ prefix, so a test key shows a clear test-mode banner.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Trading app (?app=trading) — signal-justified stock trading (ADR-052)
# -----------------------------------------------------------------------------
# Execution runs through a provider-agnostic BrokerAdapter. BROKER_PROVIDER selects the
# rail — 'alpaca' and 'schwab' are built; 'snaptrade'/'ibkr' are planned siblings.
BROKER_PROVIDER=alpaca
# Per-mode override (optional): the paper and live books can run DIFFERENT rails. Schwab has
# no paper/sandbox trading account, so it can only be the LIVE rail — keep Alpaca on paper +
# autopilot and point the live book at Schwab:
#   BROKER_PROVIDER_PAPER=alpaca
#   BROKER_PROVIDER_LIVE=schwab
# (Both default to BROKER_PROVIDER when unset.)
# BROKER_PROVIDER_LIVE=schwab
# Dual ledger = two PHYSICALLY SEPARATE Alpaca accounts with distinct key pairs.
# Paper keys are free + instant at alpaca.markets (Paper Trading → API keys).
# Aliases also accepted for the paper book: ALPACA_KEY / ALPACA_SECRET (or a single endpoint
# via ALPACA_ENDPOINT — a trailing /v2 is stripped automatically).
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
# Live keys — leave blank until the ADR-052 live review is done.
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=
# LIVE GATE: trading ships PAPER-ONLY. Live orders are refused unless this is exactly 'true'
# AND the caller confirms. Do not flip this on without the ADR-052 compliance review.
TRADING_LIVE_ENABLED=false
# Server-side guardrails applied to every order (paper and live).
TRADING_MAX_QTY=100
TRADING_MAX_NOTIONAL_USD=1000
# Optional comma-separated symbol allow-list (empty = any liquid US equity).
# TRADING_SYMBOL_ALLOWLIST=AAPL,MSFT,SPY
# Share quantity the deterministic algo-ensemble decision (/decide-algo) proposes per order.
TRADING_ALGO_QTY=1
# Autopilot risk posture: conservative | balanced | aggressive | active.
#   active = high-turnover, downside-first — 32 small names (3% each), 8% take-profit, a trailing
#   stop (arms +5%, exits on 3% giveback) + a short-timeframe breakdown exit (sells a held name
#   crashing on 5min+1h even if the weekly/quarterly trend is still up), and a 5% backstop stop.
TRADING_RISK_POSTURE=active
# Live monitor prediction horizon (hours) before a prediction is resolved vs actual price.
MONITOR_HORIZON_HRS=24
#
# Charles Schwab LIVE rail (per-user OAuth connector, ADR-052). The user connects their OWN
# Schwab account (Settings → Connections → Charles Schwab); OSHAL reads balances/positions and
# places orders via the Trader API with their brokered token. Register the app in the Schwab
# developer portal (developer.schwab.com) as an INDIVIDUAL app matching the brokerage identity;
# once approved, paste the production App Key/Secret below. The callback registered in the portal
# MUST match SCHWAB_CLIENT_CALL_BACK byte-for-byte (e.g. https://oshal.agenticfederal.us/api/connect/schwab/callback).
# NOTE: Schwab refresh tokens live ~7 days and can't be renewed → the user re-connects weekly.
SCHWAB_CLIENT_ID_PRD=
SCHWAB_CLIENT_SECRET_PRD=
SCHWAB_CLIENT_CALL_BACK=
# Optional — pick a specific account when the login has several (else the first is used).
# SCHWAB_ACCOUNT_NUMBER=
# Optional — override the Trader API + Market Data API bases (e.g. to point at the developer sandbox).
# The live book's market data (quotes + price history) reads the Market Data API on the SAME
# per-user Schwab connection — no separate credential.
# SCHWAB_TRADER_BASE_URL=https://api.schwabapi.com/trader/v1
# SCHWAB_MARKETDATA_BASE_URL=https://api.schwabapi.com/marketdata/v1

# -----------------------------------------------------------------------------
# Payments app (?app=payments) — take payments through a connected merchant account
# -----------------------------------------------------------------------------
# Square + PayPal are per-user OAuth connectors: the MERCHANT connects their own
# account (Utilities → Payments) and OSHAL charges on their behalf with their token.
# Square = a direct card charge (Web Payments SDK card token; Sandbox test token
# cnon:card-nonce-ok). PayPal = create + send an invoice the customer pays.
# Sandbox by default so the whole connect→charge flow is testable without real money.
# Register both apps under the business email (partner-app rule).
#
# Square: developer.squareup.com → your app → OAuth. Callback /api/connect/square/callback.
SQUARE_ENV=sandbox
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
# SQUARE_REDIRECT_URI=https://oshal.example.com/api/connect/square/callback
#
# PayPal: developer.paypal.com → your app → Log in with PayPal + Invoicing.
# Callback /api/connect/paypal/callback.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_REDIRECT_URI=https://oshal.example.com/api/connect/paypal/callback

# Spotify connector (music swarm) — the Spotify concierge searches the user's Spotify,
# reads now-playing + their playlists, and builds playlists on their account via the Web
# API. Create an app at developer.spotify.com/dashboard, add the redirect URI
# /api/connect/spotify/callback, and paste the Client ID + Secret here. Pressing play is a
# deep-link handoff to the user's own Spotify app (no Premium/SDK driven by OSHAL).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SPOTIFY_SCOPES=user-read-email user-read-private user-top-read user-library-read playlist-read-private playlist-read-collaborative playlist-modify-public playlist-modify-private user-read-currently-playing user-read-playback-state
# SPOTIFY_REDIRECT_URI=https://oshal.example.com/api/connect/spotify/callback
# SPOTIFY_MARKET=from_token

# Movies & TV concierge (TMDB) — discovery uses the free TMDB API: search, where-to-watch
# (JustWatch data), trailers, recommendations. Get a free key at themoviedb.org/settings/api
# (v3 API key OR a v4 read access token both work). Connect it on /utilities (TMDB card,
# shared/tenant-OK) OR set it here as the fallback. Watch/ticket links are deep-link handoffs.
TMDB_API_KEY=
# TMDB's dashboard names its keys THEMOVIEDB_API_KEY (v3) + THEMOVIEDB_API_READ_ACCESS_TOKEN
# (v4 bearer) — the app reads those too, so either naming works. v4 token is preferred.
# THEMOVIEDB_API_KEY=
# THEMOVIEDB_API_READ_ACCESS_TOKEN=
# MOVIES_REGION=US   # ISO country for where-to-watch streaming availability (default US)

# Travel concierge (Duffel) — flights/hotels/cars search + (Duffel-only) real booking via API.
# Sign up at app.duffel.com/join, then Settings > Access Tokens. A TEST token (duffel_test_...)
# returns sandbox data with no real bookings/charges; a live token (duffel_live_...) is real.
# Connect on /utilities (Duffel card, shared/tenant-OK) OR set it here as the fallback. The
# Travel app falls back to a demo catalog when no token is present.
# DUFFEL_ACCESS_TOKEN=

# External Keycloak URL for browser-facing redirects (optional)
# When running in Docker, KEYCLOAK_URL points to the internal container hostname
# (e.g., http://keycloak:8080) which browsers cannot resolve. Set this to the
# externally reachable Keycloak URL so login redirects work in the browser.
# Defaults to KEYCLOAK_URL if not set.
# KEYCLOAK_EXTERNAL_URL=http://localhost:8080

# For containerized development (API server in Docker):
# These values are overridden in docker-compose.yml to use container networking:
#   KEYCLOAK_URL=http://keycloak:8080          (internal container DNS — token exchange)
#   KEYCLOAK_EXTERNAL_URL=http://localhost:8080 (browser-facing — login redirects)
#   APP_URL=http://localhost:3456               (external access)

# -----------------------------------------------------------------------------
# Plane Integration (Swarm Intake Provider)
# -----------------------------------------------------------------------------
# Plane API base URL (e.g., http://localhost:80 for local, or https://plane.example.com for remote)
PLANE_API_URL=http://localhost:80
# Plane API token (generated from Plane UI: Settings → API Tokens)
PLANE_API_TOKEN=your-plane-api-token-here
# Plane workspace slug (e.g., 'devopscloud-01' for local dev)
PLANE_WORKSPACE_SLUG=devopscloud-01
# Plane project UUID required by the current Plane issue/work-item API when deriving intake and write-back URLs
PLANE_PROJECT_ID=your-plane-project-uuid-here
# Optional explicit intake URL; overrides PLANE_API_URL/WORKSPACE/PROJECT-derived routing when set
# Example: http://localhost:80/api/v1/workspaces/devopscloud-01/projects/<uuid>/issues/
# PLANE_INTAKE_URL=
# Optional explicit write-back URL; supports a trailing collection URL or a {externalId} placeholder
# Example: http://localhost:80/api/v1/workspaces/devopscloud-01/projects/<uuid>/issues/
# PLANE_WRITEBACK_URL=
# Optional Docker-only override used by docker-compose.dev.yml when OSHAL needs to reach Plane over an external Docker network
# PLANE_API_URL_DOCKER_INTERNAL=http://api:8000
# Optional external Docker network name used by docker-compose.dev.yml to join the Plane stack network
# PLANE_DOCKER_NETWORK=ai-lab-network

# -----------------------------------------------------------------------------
# Docker-Specific Configuration
# -----------------------------------------------------------------------------
# Node.js environment (set to 'production' in Dockerfile)
# NODE_ENV=production

# -----------------------------------------------------------------------------
# Google Search Configuration
# -----------------------------------------------------------------------------
# The hosted `google-search-mcp` container was retired 2026-07-23 (it wrapped an
# npm package that no longer resolves and ran in no active stack). Set
# GOOGLE_SEARCH_MCP_URL only if you stand up your own search MCP endpoint —
# when unset, no search MCP server is injected into managed sessions.
# Direct Google Custom Search API settings used by the built-in in-process
# google-search integration (unrelated to any MCP server):
# GOOGLE_SEARCH_API_KEY=your-google-api-key-here
# GOOGLE_SEARCH_ENGINE_ID=668e98ed420094d8e

# -----------------------------------------------------------------------------
# Google Cloud Voice (TTS / STT) — pluggable voice-providers registry
# -----------------------------------------------------------------------------
# GOOGLE_API_KEY/GEMINI_API_KEY configure Gemini voice providers only.
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# Cloud Speech-to-Text V2 uses a cloud-platform service-account token, not the
# workspace OAuth profile. Enable the Speech-to-Text API and grant the service
# account permission to call speech.recognizers.recognize (for example Speech
# Client) in the billing project. Chirp 3 defaults to the GA `us` location.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_SPEECH_LOCATION=us
# Gemini CLI harness — uses GEMINI_API_KEY first, falls back to GOOGLE_API_KEY,
# then to OAuth session at ~/.gemini/ (mounted via GEMINI_CONFIG_HOST_PATH).
# GEMINI_MODEL=gemini-2.5-pro
# GEMINI_CLI_PATH=gemini
# GEMINI_TIMEOUT_MS=600000
# GEMINI_CONFIG_HOST_PATH=~/.gemini

# OpenRouter (ADR-064 free-tier). The platform's OWN OpenRouter key — an INVISIBLE default
# fallback: when a user has connected no key of their own, requests run on this key, so the swarm
# runs FOR FREE by default. Used by resolveUserLlmConnection as the last-resort fallback (and by
# Cline directly when openrouter is the active provider). Only `:free` models, so it cannot spend.
# Get a key at https://openrouter.ai/keys. Keep the value ONLY here (gitignored) — never commit it.
# Prove it works: OPENROUTER_API_KEY=... npx ts-node ... scripts/evidence/prove-free-tier-live.ts
#
# !! THE $10 CATCH (openrouter.ai/docs/api-reference/limits): :free models are capped by the
#    account's LIFETIME credit purchase — under $10 = 50 :free requests/DAY; $10+ = 1,000/day
#    (20/min either way). A ~30-bot swarm blows past 50/day almost immediately, so a fresh
#    zero-credit key is DEMO-ONLY. Put a one-time $10 on this account to make free-by-default real:
#    it's credit (not a subscription), :free models still cost $0, the $10 only lifts the daily
#    ceiling. Users who connect their OWN key get their own limit — the shared key is the floor.
# OPENROUTER_API_KEY=
# OPTIONAL first-choice free model. The fallback PROBES a rotation of :free models (they churn —
# delist/paid/rate-limit constantly), so leaving this blank is fine; set it to try one first:
# OPENROUTER_FREE_MODEL=openai/gpt-oss-20b:free
#
# Other free lanes (ADR-064 Plan B). Free signup, NO credit card. These are OPERATOR/platform keys —
# they feed the free-lane proof (scripts/evidence/prove-free-tier-live.ts) and the Token Chase
# optimizer's cheap replay lanes. A USER pastes their OWN free tiers in the connect UI instead
# (/api/connect/free-tier → per-user encrypted store); those never come from env.
# Paste here, then recreate the api so the containers pick them up:
#   docker compose -f docker-compose.oshal-local.yml up -d --no-deps oshal-api
# GROQ_API_KEY=            # https://console.groq.com/keys
# CEREBRAS_API_KEY=        # https://cloud.cerebras.ai/
# MISTRAL_API_KEY=         # https://console.mistral.ai/api-keys/
# HF_TOKEN=                # https://huggingface.co/settings/tokens (Inference Providers router; $0.10/mo credit free, $2 PRO; alias HUGGINGFACE_API_KEY)
# Gemini/AI Studio free tier reuses GOOGLE_API_KEY (or GEMINI_API_KEY) above — https://aistudio.google.com/apikey
#
# Token Chase per-run SPEND ceiling in USD (ADR-046 hardening). The optimizer consults this
# before every replay round and stops cleanly when the run's accumulated measured spend
# crosses it. Always finite — unset means the built-in default ($25), never unlimited.
# TOKEN_CHASE_BUDGET_USD=25
#
# Separate per-run JUDGE-call ceiling in USD. Checked before each quality-judge call;
# unset/zero/invalid values use the finite $5 default rather than enabling unlimited spend.
# TOKEN_CHASE_JUDGE_BUDGET_USD=5
#
# Keep-winner promotion is deliberately opt-in. When true, only LLM-judged,
# equivalent-cheaper lanes meeting both thresholds become the frame's next baseline.
# Operators can always use the authenticated promote/revert endpoints instead.
# TOKEN_CHASE_AUTO_PROMOTE=false
# TOKEN_CHASE_PROMOTE_MIN_QUALITY=80
# TOKEN_CHASE_PROMOTE_MIN_SAVINGS_USD=0
#Field	Value
##User	readonly-service-user
#Access Key ID	__SET_AT_DEPLOY_TIME__
#Secret Access Key	__SET_AT_DEPLOY_TIME__
#Policy	ReadOnlyAccess (AWS managed — read-only across all services)
#Save the secret access key now — you won't be able to retrieve it again. To use it:

# --- Operations & SecOps connectors (ADR-069, connector runtime) ---------------
# These ride the ADR-065 connector runtime (per-user broker token preferred; the
# CONNECTOR_<PROVIDER>_TOKEN below is the operator-level fallback). The *_BASE_URL
# vars feed the spec loader's ${env:NAME} interpolation for per-tenant hosts.
#
# Dynatrace — per-environment host carries your env id (SaaS or Managed /e/<id>):
# DYNATRACE_BASE_URL=https://YOUR-ENV-ID.live.dynatrace.com/api/v2
# API token MUST include the 'Api-Token ' prefix (scopes: problems/entities/metrics/events .read):
# CONNECTOR_DYNATRACE_TOKEN=Api-Token dt0c01.XXXXXXXX
#
# ServiceNow (ADR-069 Phase 2 - supersedes the SERVICENOW_* MCP env vars with a per-user connector):
# SERVICENOW_BASE_URL=https://YOUR-INSTANCE.service-now.com
# CONNECTOR_SERVICENOW_TOKEN=
#
# Datadog - site-specific host + TWO keys (DD-API-KEY per-user, DD-APPLICATION-KEY operator-level):
# DATADOG_BASE_URL=https://api.datadoghq.com
# CONNECTOR_DATADOG_TOKEN=
# DATADOG_APP_KEY=
#
# New Relic - REST API v2, User key in X-Api-Key:
# NEW_RELIC_BASE_URL=https://api.newrelic.com/v2
# CONNECTOR_NEWRELIC_TOKEN=
#
# Microsoft Sentinel (SecOps SIEM) - global ARM base; workspace coordinates bind from these env vars
# into the connector path. Azure AD bearer (client_credentials auto-mint is a follow-up):
# AZURE_SUBSCRIPTION_ID=
# SENTINEL_RESOURCE_GROUP=
# SENTINEL_WORKSPACE=
# CONNECTOR_SENTINEL_TOKEN=
#
# VirusTotal (SecOps threat intel) - global base, x-apikey header:
# CONNECTOR_VIRUSTOTAL_TOKEN=
#
# Elastic Security (SecOps SIEM) - per-deployment Kibana host; API key MUST include the 'ApiKey ' prefix:
# ELASTIC_BASE_URL=https://YOUR-DEPLOYMENT.kb.us-central1.gcp.cloud.es.io
# CONNECTOR_ELASTIC_SECURITY_TOKEN=ApiKey BASE64KEY
#
# Tenable (SecOps vuln scanning) - global base; both keys in one header value:
# CONNECTOR_TENABLE_TOKEN=accessKey=AAAA;secretKey=BBBB
#
# Microsoft Defender for Cloud (SecOps CSPM) - global ARM base; subscription binds from env; Azure AD bearer:
# AZURE_SUBSCRIPTION_ID=          (shared with Sentinel)
# CONNECTOR_DEFENDER_CLOUD_TOKEN=

# =============================================================================
# Developer Console — super-admin self-development (ADR-077)
# =============================================================================
# A DISTINCT, more privileged role than operator. Double-gated + fail-closed:
#   1) the capability must be explicitly enabled on this deployment, AND
#   2) the caller must be on the dedicated super-admin allowlist below.
# Both default OFF/empty, so an untouched deployment does NOT expose the console.
# Being an operator does NOT grant super-admin — keep these lists separate.
# OSHAL_DEV_CONSOLE_ENABLED=false
# OSHAL_SUPERADMIN_EMAILS=you@example.com
# OSHAL_SUPERADMIN_SUBS=
#
# Self-edit AGENT mode (Phase 2). Demo mode needs none of this. A real LLM agent (claude/codex)
# edits inside a locked-down container; it MUST have a narrow provider-egress network — agent mode
# refuses to start without OSHAL_DEV_AGENT_NETWORK set (open egress + the seeded repo + creds would
# be an exfil path). Configure a firewalled/allowlist network, not 'bridge'.
# OSHAL_DEV_AGENT_NETWORK=oshal-egress-allowlist
# OSHAL_DEV_AGENT_IMAGE=any-bot:latest
# OSHAL_DEV_AGENT_CREDS=C:/Users/you/.claude   # mounted read-only at /root/.claude for auth
# OSHAL_DEV_AGENT_BIN=claude
# OSHAL_DEV_AGENT_ARGS=-p
#
# Dev-Node (ADR-077 Option B): run the self-edit engine on the HOST (not the container).
# Start it with `npm run dev:node` on the box that has the repo + docker. The api proxies
# super-admin session requests to it over host.docker.internal, authed by a shared secret.
# OSHAL_DEV_NODE_SECRET=<a strong random secret, >=16 chars — same value on api + dev-node>
# OSHAL_DEV_NODE_URL=http://host.docker.internal:35460   # set on the api only
# OSHAL_DEV_NODE_PORT=35460                                # set on the dev-node only (default 35460)
# OSHAL_REPO_ROOT=/abs/path/to/the/checkout                # dev-node only; defaults to its cwd
#
# Dev-node CAPABILITIES — both OFF by default, both act on the LIVE box, so they are opt-in per
# deployment rather than implied by running a dev-node. Unset ⇒ the routes answer 503 and the Dev
# panel reports the capability as absent (the honest state for a checkout that is not the one
# being served — pointing a dev-node at the wrong tree is the failure these prevent).
#
#   LIVE_APPLY writes approved asset/manifest/persona/package changes straight into the checkout
#   and takes that class's restart action (none / app-reload / bot-restart / api-restart). core and
#   infra changes are REFUSED here by construction and routed to the PR + promote path instead.
# OSHAL_DEV_LIVE_APPLY=false
#
#   PROMOTE runs the verified deploy (scripts/oshal-deploy.sh) for core changes already merged to
#   the trunk, preserving its four-outcome exit contract: 0 deployed / 1 rolled back, still serving
#   / 2 preflight refused / 3 nothing serving, needs hands.
# OSHAL_DEV_PROMOTE=false
#
#   Windows only: the absolute Git Bash used to run the deploy script. Auto-detected from the usual
#   install locations; set it if Git lives elsewhere. Bare `bash` is REFUSED — on Windows it resolves
#   through PATH into System32/WSL, a different filesystem namespace where the repo path, the Docker
#   socket and the compose project are not what the script assumes.
# OSHAL_DEPLOY_BASH=C:\Program Files\Git\bin\bash.exe

# =============================================================================
# OSHAL Developer bot — in-swarm platform development (ADR-081)
# =============================================================================
# The dedicated oshal-developer bot-node owns ticketType 'oshal-dev' and works in
# its OWN clone (named volume /app/dev-repo — never the live tree). Dispatch is
# PRIVILEGED: only tickets owned by a sub on OSHAL_SUPERADMIN_SUBS (above) run.
# Where the bot clones from + pushes to (configurable per deployment):
# OSHAL_DEV_REPO_URL=https://github.com/emeraldcoastsystemsgroup/open-shal.git
# OSHAL_DEV_REPO_BRANCH=main
# Push/clone auth for private repos — read from env by a credential helper at use
# time, never persisted into the clone. A fine-grained token with contents:rw suffices.
# OSHAL_DEV_REPO_TOKEN=
# Owner of the nightly docs-quality ticket (04:00; must be a super-admin sub or the
# dispatch gate escalates it). Unset = no nightly ticket.
# OSHAL_DEV_OWNER_SUB=
# OSHAL_DEV_DOCS_CRON=0 4 * * *
# Idle/backstop windows for the dev bot's codex runs (ms):
# OSHAL_DEV_IDLE_TIMEOUT_MS=600000
# OSHAL_DEV_MAX_DURATION_MS=7200000
#
# Codex harness timeouts are IDLE-BASED platform-wide (ADR-081): the timer bounds
# SILENCE (no stdout/stderr), not total runtime; a separate hard cap backstops runaways.
# CODEX_INACTIVITY_TIMEOUT_MS=600000
# CODEX_MAX_DURATION_MS=7200000

# =============================================================================
# Worker nodes joining this swarm (remote clients / A2A)
# =============================================================================
# A second machine becomes a worker node by presenting this secret in an auth
# header. Leave it EMPTY to refuse every node (session-authenticated callers only).
#
# The Windows installer (Install-OpenSwarm.bat) generates one for you on first
# run and packs it, together with this machine's LAN URL, into the OSJOIN1.*
# join code it prints. Rotating this value invalidates every node that joined.
#
# Generate one by hand with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REMOTE_CLIENT_SHARED_SECRET=
REMOTE_CLIENT_AUTH_HEADER=x-remote-client-key

# ── Retire the swarm-wide secret: per-node tokens (hardening #7) ─────────────
# The value above is ONE secret shared by every node, and it is MACHINE TRUST: a
# request bearing it skips the per-device ownership gate entirely, so one leaked
# copy reaches every person's desktop, and it cannot be rotated for one machine.
#
# The replacement: enroll each computer for a token BOUND to that computer.
#   POST /api/join/enroll  {"clientId": "<the node's clientId>"}
#     -> an oshal_pat_ token that authenticates ONLY on
#        /api/remote-clients/<clientId>/** plus the enrollment handshake. It is
#        NOT an account credential (it cannot reach /api/content, cannot mint
#        tokens, cannot touch a sibling device), and it is revocable + rotatable:
#   POST /api/remote-clients/<clientId>/token/rotate
#     -> mints the successor and revokes every prior generation in one call.
# Put the token in the node's REMOTE_CLIENT_CONTROL_PLANE_TOKEN.
#
# Set this to true ONLY once every node is re-enrolled: it makes the shared-secret
# branch answer 401 shared_secret_retired. Until then the branch stays accepted but
# LOUDLY deprecated (one warn per boot + x-oshal-shared-secret-deprecated on every
# response it admits), so you can watch re-enrollment finish before flipping.
REMOTE_CLIENT_REQUIRE_NODE_TOKEN=false

# ── Web hardening: CSP + body limit (SECURITY-HARDENING.md §4) ───────────────
# CSP DEFAULT (no variable set): the strict policy on the NON-BLOCKING
# Content-Security-Policy-Report-Only header, with violations POSTed to
# /api/security/csp-report and logged once per distinct finding. Nothing is
# blocked, so no surface can break — the point is to learn the real allowlist.
#   OSHAL_STRICT_CSP=on     -> ENFORCE (blocking). Only after the report-only log
#                              is clean; the cockpit still has inline <script>.
#   OSHAL_CSP_REPORT_ONLY=on-> pin report-only even with the enforce flag set.
#   OSHAL_CSP=off           -> kill switch: no CSP header at all.
#   OSHAL_CSP_REPORT_URI    -> an alternative collector.
OSHAL_STRICT_CSP=
OSHAL_CSP_REPORT_ONLY=
# Global JSON request-body limit (every route except /api/remote-clients,
# /api/vision and /api/hooks, which own their parsers). Oversized bodies 413.
OSHAL_JSON_BODY_LIMIT=100kb

# ── Inbound A2A gateway (ADR-109 / BACKLOG Plan F) — DEFAULT OFF ─────────────
# External third-party A2A agents delegating work INTO this swarm over JSON-RPC
# (message/send | tasks/get | tasks/cancel) with operator-minted per-agent bearer
# credentials (POST /api/a2a/agents). Leave A2A_GATEWAY_ENABLED unset and the
# ENTIRE surface — the /.well-known/agent-card.json discovery card AND the
# POST /api/a2a endpoint — answers 404, so an unconfigured deployment exposes
# nothing (not even the swarm's existence). Only the literal string "true"
# enables it. Before enabling, confirm the running image contains the ADR-087
# role-gate parity fix (commit 236589b8). Full flip procedure + verification steps
# (migration check, card 200 probe, disabled=404 re-proof, paid inbound proof):
# docs/runbooks/a2a-gateway-local-enable.md
# A2A_GATEWAY_ENABLED=true
#
# Absolute base URL stamped into the agent card so external agents dial the
# public endpoint, not the tunnel-internal Host header (relevant behind
# cloudflared). Empty = derive scheme://host from the incoming request.
# A2A_PUBLIC_BASE_URL=https://oshal.example.com
#
# Per-agent inbound ticket ceiling per rolling hour (fail-closed: an unreadable
# count rejects). Default 20; garbage/zero/negative fall back to the default.
# A2A_MAX_INBOUND_PER_HOUR=20

# Where Docker Desktop can see this repo, used when the API inserts bot containers
# on the fly. The Windows installer sets this automatically. On Windows it looks
# like /run/desktop/mnt/host/c/Users/you/openswarm
# OSHAL_DOCKER_PROJECT_ROOT=

# #############################################################################
# MUST CHANGE BEFORE ANYONE ELSE CAN REACH THIS
# #############################################################################
# Every one of these has a working fallback so a laptop install "just works".
# Every one of those fallbacks is a hole once the host is reachable by someone
# who is not you. Mint them with: openssl rand -base64 32
# (the Windows installer does it for you).

# Signs the JWTs handed to dynamically-launched bot containers.
# src/features/agent-management/services/dynamic-compose-service.ts:213 falls back
# to the literal 'oshal-local-dev-secret-do-not-use-in-prod'. Nothing warns you.
JWT_SECRET=

# REQUIRED controller-only key for the per-user AES-GCM connector/OAuth store.
# Secret reads/writes and OAuth start/import fail closed when it is empty; plaintext
# secrets.json fallback has been retired. Generate with: openssl rand -base64 32
# Rotating it makes every stored OAuth token undecryptable - back up first.
ENCRYPTION_KEY=

# Shared secret for internal service-to-service calls (X-Service-Secret).
# src/shared/middleware/authz.ts:116 is FAIL-CLOSED: unset means bot-node ->
# controller calls fall through to normal auth and quietly 401. On the OTHER
# direction (controller -> bot-node execution endpoints) unset = fail-OPEN for
# local dev, but the bot-node WARNs at startup and per allowed request
# (src/app/bot-node-request-auth.ts). Set it whenever bots run in separate
# containers - same value on the controller + every bot.
SWARM_SERVICE_SECRET=

# Standalone drone node. Sim is the safe default. Hardware mode additionally
# requires a unique MAVLink 2 signing key shared only with that airframe's flight
# controller; generate 32 random bytes and encode them as exactly 64 hex chars.
# Never reuse SWARM_SERVICE_SECRET as the packet-signing key.
# DRONE_PROVIDER=sim
# DRONE_NODE_ID=drone-1
# DRONE_NODE_PORT=4100
# DRONE_NODE_ENDPOINT=http://127.0.0.1:4100
# DRONE_MAVLINK_URL=tcp://127.0.0.1:5760
# DRONE_MAVLINK_SIGNING_KEY=
# DRONE_MAVLINK_SIGNING_LINK_ID=1

# Ed25519 controller-to-bot HTTP delegation. These values are role-separated by
# docker-compose.oshal-local.yml: the controller receives the active private JWK + kid;
# bot nodes receive only the public JWK rotation ring. Configuration is atomic/fail-closed:
# a key without its pair fails startup, a bot with a public ring requires a signed token,
# and a controller with a private key never falls back to unsigned localhost execution.
# See docs/security/http-delegation.md for generation, rollout, rotation, and rollback.
# OSHAL_DELEGATION_SIGNING_KID=delegation-2026-08
# OSHAL_DELEGATION_SIGNING_PRIVATE_KEY={"kty":"OKP","crv":"Ed25519","x":"PUBLIC_COMPONENT","d":"PRIVATE_COMPONENT"}
# OSHAL_DELEGATION_PUBLIC_KEYS={"delegation-2026-08":{"kty":"OKP","crv":"Ed25519","x":"PUBLIC_COMPONENT"}}
# OSHAL_DELEGATION_ISSUER=urn:oshal:controller
# OSHAL_DELEGATION_AUDIENCE=urn:oshal:bot-node
# OSHAL_DELEGATION_TTL_SECONDS=4200
# OSHAL_DELEGATION_CLOCK_SKEW_SECONDS=30

# Durable workload-to-user API delegation (SEC-01). Roll out in order: legacy -> shadow ->
# enforce. Shadow validates bearer delegations and records remaining fleet-secret user-route
# traffic; enforce refuses X-Service-Secret as user identity on every delegated Graph/Jarvis route.
# The controller needs the PUBLIC half of its signing key here so it can verify incoming API
# delegations without weakening bot-node key-role separation. Migration 119 must be applied first.
# OSHAL_WORKLOAD_DELEGATION_MODE=legacy
# OSHAL_WORKLOAD_DELEGATION_PUBLIC_KEYS={"delegation-2026-08":{"kty":"OKP","crv":"Ed25519","x":"PUBLIC_COMPONENT"}}
# OSHAL_WORKLOAD_DELEGATION_AUDIENCE=urn:oshal:api
# OSHAL_WORKLOAD_DELEGATION_TTL_SECONDS=900

# Per-user app doorway enforcement (ADR-118). Apply migration 121 before enabling any manifest
# with an `access:` declaration. The default is `enforce`; unknown values also fail closed to
# enforce. Use `shadow` only for the observation window, seed explicit assignments through the
# operator matrix, then remove the override (or set `enforce`). Database failures return 503 for
# declared apps in both modes; shadow never turns a missing access store into an allow.
# OSHAL_APP_ACCESS_MODE=shadow

# Tokens for the otherwise-unauthenticated ingest routes. Unset = route is open.
# OSHAL_INTERNAL_TOKEN=          # src/app/routes/llm-governance-routes.ts:42
# WORLD_INGEST_TOKEN=            # src/app/routes/world-routes.ts:30
# AUTH_SESSION_SECRET=           # src/shared/middleware/guest-session.ts:36
# PROMETHEUS_PORT=9091          # The monitoring overlay's default 9090 collides with oshal-headscale's
#                               # metrics port on the dev box. Reload config with scripts/monitoring-up.sh -
#                               # `compose up -d` does NOT reload a bind-mounted prometheus/alertmanager config.
# ALERT_WEBHOOK_TOKEN=
# ALERT_WEBHOOK_HMAC_SECRET=     # src/app/routes/alertmanager-routes.ts:208

# Alert triage Stage D bundling knobs (ADR-119 P2). Defaults live in
# src/features/alert-triage/services/alert-triage-constants.ts - set these only
# to retune. Window/depth 0 disables bundling / dependency correlation.
# ALERT_CORRELATION_WINDOW=900   # seconds an OPEN incident stays bundleable (FR-D1)
# ALERT_CORRELATION_DEPTH=3      # dependency hops for related-target bundling (FR-D3)
# ALERT_MAX_MEMBERS=50           # recorded members per incident; beyond = overflow counter (FR-D5)
# ALERT_DEPENDENCY_MAP=          # JSON file {"edges":[["dependent","dependency"],...]} extending the static compose map

# Alert triage Stage B claim registry + Stage E dispatch gates (ADR-119 P3).
# Defaults in alert-triage-constants.ts / claim-registry.ts. With NO claims file
# and NO ALERT_APPROVED_NAMES the intake accepts every firing alert (dev default);
# ALERT_APPROVED_NAMES stays valid as a pure-claim shorthand.
# ALERT_CLAIMS_FILE=             # JSON {"rules":[{"match":{"alertname":"..."|["..."],"labels":{...}},"incidentKey":"{alertname}::{target}","intake":"approved|backlog","bundleHints":{"rootFilter":["..."]}},...]} (FR-B1; invalid rules rejected loudly at load)
# ALERT_UNCLAIMED_POLICY=drop    # drop = unclaimed alerts are counted noise; backlog = park them as backlog tickets (FR-B2)
# ALERT_RCA_HOURLY_BUDGET_USD=10 # sliding-hour analyst cap; over budget parks auto-flows visibly as analysis-skipped:budget (FR-E2)
# ALERT_FLAP_THRESHOLD=5         # refires inside the window that mark an incident flapping (FR-E3)
# ALERT_FLAP_WINDOW=1800         # flap observation window seconds; 0 disables flap damping (FR-E3)
# ALERT_FLAP_QUIET=600           # quiet seconds that end a flap episode and restore a flap-parked ticket (FR-E3)
# ALERT_AUTO_RESOLVE=false       # true: a FULLY-resolved still-backlog incident self-closes; approved+ never auto-closes (FR-E4)

# Alert triage P4 — the ADR-119 autonomy ladder (A2 bounded auto-apply).
# Defaults in alert-triage-constants.ts. A1 (zero-touch ANALYSIS) is per-rule via
# the `intake: auto` label in ops/monitoring/alert-rules.yml, not an env knob.
# SELF_HEAL_AUTO_APPLY=false     # THE KILL SWITCH (default false): true lets a Mode-A restart-container proposal on a NON-core worker container auto-apply + verify; off = A1 exactly (proposals wait at the approve gate). Core infra (api/db/redis/…) NEVER auto-applies regardless.
# SELF_HEAL_APPLY_HOURLY_CAP=3   # global sliding-hour auto-apply cap (ADR-119 A2 bound 2); 0 parks every apply visibly
# SELF_HEAL_VERIFY_TIMEOUT=120   # seconds the restarted target has to be OBSERVED healthy before the ticket may complete; failure escalates with needs-attention (bound 3)
# SELF_HEAL_NODE_URL=http://oshal-local-self-healing:5000  # the self-healing bot node's apply endpoint (profile-gated container; unreachable => applies fail visibly and escalate)

# =============================================================================
# Core wiring (compose supplies these; set them only for a bare "node" run)
# =============================================================================
# Postgres DSN. NO default in code - src/app/composition/app-runtime-factory.ts:54
# silently runs pool-less if unset, which disables the agent registry, profile
# seeding and cost tracking. docker-compose.oshal-local.yml:182 supplies it.
# DATABASE_URL=postgresql://oshal_app:oshal-app-dev@oshal-db:5432/oshal
# BOOTSTRAP_DATABASE_URL=postgresql://oshal:oshal@oshal-db:5432/oshal
# BOT_DATABASE_URL=postgresql://oshal_bot:oshal-bot-dev@oshal-db:5432/oshal
#
# DigitalOcean Managed PostgreSQL 18 (CRM production): put these three values in
# the CRM deployment's separate env file, never the localhost/site env. Use the
# same PRIVATE/VPC host, port, and database in all three URLs. Generate distinct
# app/bot passwords with `openssl rand -hex 24`; BOOTSTRAP_DATABASE_URL retains
# the doadmin password supplied by DigitalOcean. Download the cluster CA to
# config-seed/do-postgres-ca.pem (gitignored), then add this query to every URL:
#   ?sslmode=verify-full&sslrootcert=/app/config-seed/do-postgres-ca.pem
# The production guard requires DigitalOcean port 25060 and a dedicated database
# named `oshal` (create it as doadmin before running the launcher).
# The same root-owned mode-0600 CRM env must also pin a deployment identity and
# immutable bot release: the launcher only accepts a `@sha256:<digest>` or
# `:sha-<git-sha>` reference (never `latest` or a mutable semver tag):
#   OSHAL_MANAGED_DEPLOYMENT_ID=gsquared-crm-prod
#   OSHAL_BOT_IMAGE=ghcr.io/emeraldcoastsystemsgroup/oshal-bot:sha-4990bb40
#   POSTGRES_CA_CERT_PATH=/app/config-seed/do-postgres-ca.pem
# Before first deploy, deliberately create the matching root-owned host marker:
#   install -d -o root -g root -m 0755 /etc/oshal
#   printf '%s\n' gsquared-crm-prod >/etc/oshal/deployment-id
#   chown root:root /etc/oshal/deployment-id
#   chmod 0644 /etc/oshal/deployment-id
# Fixed container names make a second OSHAL stack on the same host unsupported;
# use a dedicated CRM Droplet. The launcher still pins the Compose project name
# and rejects a marker/env mismatch before it can create or remove containers.
# Deploy only through:
#   bash scripts/managed-postgres-compose.sh /path/to/crm-production.env up
# CHROMADB_URL=http://oshal-chromadb:8000
# ARANGO_URL=                    # unset => /api/graph returns 503 (ADR-045; the graph tier is optional)
# OSHAL_API_PORT=35457           # host port for the cockpit
# OSHAL_REDIS_PORT=56380         # host-published Redis port
# RUN_MIGRATIONS=true
# LOG_LEVEL=info
# LANDING_PATH=/cockpit/         # where a bare "/" lands
# REJECT_LOOP_TICKETS=false      # 429 the stale-browser-tab loop-* tickets

# =============================================================================
# Identity: leave ALL of these unset to use Keycloak (or MOCK_OIDC=true)
# =============================================================================
# Setting OIDC_ISSUER_URL switches src/shared/middleware/oidc.ts:151 off the
# Keycloak realm path onto a generic issuer (Entra / Okta / Auth0).
# Set all three together, or none.
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_BASE_URLS=                # extra allowed callback origins, comma-separated
#
# ── Multi-provider login (ADR-126) ──────────────────────────────────────────
# The OIDC_* block above is the PRIMARY provider (it keeps /callback and the
# default session cookie). Per-provider flags add/remove login methods; with
# more than one enabled, /login shows a chooser page. Fail-closed: enabling a
# provider with incomplete credentials refuses to boot, as does disabling all.
# GOOGLE_LOGIN=true              # governs the Google provider (default true when
#                                # OIDC_ISSUER_URL is accounts.google.com)
# MICROSOFT_LOGIN=false          # adds "Continue with Microsoft" (Entra ID) —
#                                # full enable procedure: docs/runbooks/microsoft-login-enable.md
# MICROSOFT_TENANT_ID=           # builds https://login.microsoftonline.com/<tenant>/v2.0
# MICROSOFT_OIDC_ISSUER_URL=     # or set the issuer explicitly — tenant-SPECIFIC only,
#                                # 'common'/'organizations' fail OIDC issuer validation
# MICROSOFT_OIDC_CLIENT_ID=      # Azure app registration (register under the business
# MICROSOFT_OIDC_CLIENT_SECRET=  # email — docs/partner-app-registration.md); add
#                                # https://<each login host>/callback/microsoft as a Web
#                                # redirect URI, verify with
#                                # scripts/check-oidc-redirect-uris.sh -p microsoft <host>
# OUTLOOK_LOGIN=false            # adds "Continue with Outlook.com" — PERSONAL Microsoft
#                                # accounts (outlook.com/hotmail) via the fixed consumers
#                                # tenant. Same runbook as MICROSOFT_LOGIN. The Azure app's
#                                # supported-account-types must include personal accounts;
#                                # redirect URI per login host: https://<host>/callback/outlook
# OUTLOOK_OIDC_CLIENT_ID=        # optional — defaults to MICROSOFT_OIDC_CLIENT_ID
# OUTLOOK_OIDC_CLIENT_SECRET=    # optional — defaults to MICROSOFT_OIDC_CLIENT_SECRET
# GOOGLE_OIDC_CLIENT_ID=         # only needed when Google is a SECONDARY next to a
# GOOGLE_OIDC_CLIENT_SECRET=     # non-Google primary (callback /callback/google)
# KEYCLOAK_CLIENT_SECRET=
# SESSION_COOKIE_DOMAIN=         # cross-subdomain sessions; comma-separated list OK
#   (e.g. .agenticfederal.us,.oshal.ai) — resolved PER HOST: each login host gets the
#   matching entry, or a host-only cookie when none matches. A domain that doesn't
#   cover the host is never applied (the browser would reject it and the login would
#   die at /callback with "checks.state argument is missing").

# Themed app subdomains (dnd.oshal.ai, trading.oshal.ai, littlemonsters.oshal.ai, ...): each
# hostname must ALSO be added to OIDC_BASE_URLS above (per-host login) and to the Cloudflare
# Tunnel as a Public Hostname pointing at the same origin — see
# docs/runbooks/cloudflare-tunnel-dns.md. Unset = current single-host behavior (LANDING_PATH).
# HOST_APP_MAP=                  # comma-separated hostname=appName, e.g. dnd.oshal.ai=dnd,trading.oshal.ai=intelligent-trades,littlemonsters.oshal.ai=little-monsters

# Who counts as an operator (Security Center, join codes, oshal-dev tickets).
# OSHAL_OPERATOR_EMAILS=
# OSHAL_OPERATOR_SUBS=           # OIDC subs; ALSO exempts the operator's background/scheduled
#                                # runs from the free-tier LLM legs (interactive requests use
#                                # the ambient identity, which covers OSHAL_OPERATOR_EMAILS too)
# OSHAL_ALLOW_LEGACY_UNOWNED=false   # security: allow pre-ownership rows to be read

# Pumpkin prop (?app=pumpkin): optional allowlist of who may DRIVE the jack-o'-lantern's input
# (mimic "say this" + autonomous chat + room pushes). Everything is already owner-scoped by OIDC
# sub; set these to further restrict to specific people/devices (fail-closed to the list +
# operators). Leave BOTH unset for owner-only (any authenticated caller drives their own prop).
# PUMPKIN_ALLOWED_SUBS=            # comma-separated OIDC subs
# PUMPKIN_ALLOWED_EMAILS=          # comma-separated emails

# =============================================================================
# LLM providers - bring your own key, or sign in through the cockpit
# =============================================================================
# ANTHROPIC_API_KEY / GOOGLE_API_KEY / GEMINI_API_KEY are declared above.
# These were missing entirely:
# OPENAI_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# CEREBRAS_API_KEY=              # serves gpt-oss-120b
# HF_TOKEN=                      # Hugging Face Inference Providers (router.huggingface.co/v1); alias HUGGINGFACE_API_KEY
# SAMBANOVA_API_KEY=
# NEBIUS_API_KEY=
# AZURE_API_KEY=
# Codex fleet model — compose defaults to gpt-5.5 (the ChatGPT-login model floor).
# Pick by ChatGPT plan: $200 Pro → gpt-5.5 (default). $20 Plus → gpt-5.4 — half the
# per-token burn of 5.5; 5.5 exhausts a Plus plan's weekly limits fast. gpt-5.6-sol
# is the interactive frontier model: never the fleet default (heaviest burn).
# gpt-5.3-codex is the API-key model name; a ChatGPT login does NOT support it.
# CODEX_MODEL=gpt-5.4
# Per-spawn reasoning effort (compose default: high). gpt-5.5/gpt-5.4 accept
# none|low|medium|high|xhigh. On a $20 Plus plan, medium stretches limits further.
# CODEX_REASONING_EFFORT=medium

# AWS Bedrock (any-bot/server/services/llm/BedrockProvider.js:50)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-gov-west-1

