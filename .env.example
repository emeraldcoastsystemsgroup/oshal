# =============================================================================
# Platform notifications + hardening knobs (added 2026-07-10) — all OPTIONAL.
# Absent = feature is a no-op; nothing here is required to boot.
# =============================================================================

# --- Pluggable operator notifications (src/features/notifications) ---
# The default transport notifyOperator() uses; unset => telegram. Options: telegram | twilio-sms | twilio-voice | twilio-whatsapp | noop
# NOTIFY_TRANSPORT=telegram
# Telegram (free, first-party): TELEGRAM_BOT_TOKEN is set above for the inbound channel; the
# outbound notifier also needs the destination chat id (the chat that messaged the bot first).
# TELEGRAM_CHAT_ID=
# Twilio (paid, universal reach — BYO account; used by twilio-sms + twilio-voice + twilio-whatsapp):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=                  # never commit a real value; set by hand
# TWILIO_FROM_NUMBER=                 # your Twilio number, E.164 e.g. +15550001111
# TWILIO_TO_NUMBER=                   # destination for SMS/voice (or NOTIFY_SMS_TO / NOTIFY_VOICE_TO)
# WhatsApp-via-Twilio (sanctioned WhatsApp Business reseller path — same account, no Meta verification):
# TWILIO_WHATSAPP_FROM=               # your Twilio WhatsApp sender, E.164 (whatsapp: prefix added for you)
# TWILIO_WHATSAPP_TO=                 # WhatsApp destination (or NOTIFY_WHATSAPP_TO)

# --- RLS identity strictness (src/shared/services/database/guc-pool) ---
# deny (DEFAULT, fail-closed) | warn (log each identity-less DB call site once, operator behavior) |
#   off (break-glass rollback to the historical fail-open-to-operator).
# DEFAULT is now 'deny' (2026-07-20): a bare DB access with NO request identity AND NOT under the
# runWithSystemIdentity sentinel is stamped anonymous non-operator, so RLS scopes it to nothing —
# an un-migrated background caller fails loudly instead of reading cross-tenant. Every legitimate
# background path (schedulers, queue, workers, boot, crons, bot-node execute) already runs under the
# SYSTEM sentinel (guarded by tests/unit/background-system-identity.spec.ts).
# ROLLOUT: set OSHAL_DB_GUC_STRICT=warn in a live environment FIRST to log any identity-less call
# site the static guard can't see; confirm none are legitimate background paths; then remove the pin
# to let the deny default enforce. Break-glass on an outage: OSHAL_DB_GUC_STRICT=off.
# Any unrecognized value falls back to deny. See docs/governance/RLS-RUNBOOK.md.
# OSHAL_DB_GUC_STRICT=deny

# --- Connector token envelope encryption (src/app/routes/connector-token-crypto) ---
# ON by default (2026-07-20): connector access/refresh tokens in oshal_connections are encrypted
# with a per-user data key (DEK); new DEK wrappers use the `hkdf1:` domain-separated HKDF-SHA256
# KEK and tokens use `v2:`. decryptToken remains format-aware, so pre-versioned raw-SHA256 blobs
# remain readable during migration. New shared/rollback writes use versioned `k2:` HKDF, never the
# legacy raw-hash format. SESSION_SECRET is mandatory and missing key material fails loud.
# Rollback: `OSHAL_ENVELOPE_CRYPTO=false` writes `k2:` shared-HKDF blobs. A DEK-store error denies
# writes by default. Only a deliberate incident response may set OSHAL_ENVELOPE_DEK_FAILURE to the
# exact value `shared-hkdf`; this logged break-glass writes k2 and should be removed after recovery.
# OSHAL_ENVELOPE_CRYPTO=true
# OSHAL_ENVELOPE_DEK_FAILURE=deny

# --- Bot-node dispatch auth (src/app/bot-node-server) ---
# SWARM_SERVICE_SECRET (set above) gates every non-health bot-node route, including
# /api/swarm-execute and replay. Startup fails when it is absent; mismatch/absence returns 401.
# Bot-node port 5000 is expose-only in docker-compose.oshal-local.yml, so workers are reached over
# the Docker network rather than a host-published port.
#
# ADR-034 authoritative provider/model stamping is ON when unset. Each promoted remote dispatch
# carries either the agent_config record or an explicit required-but-unavailable marker; the bot
# refuses missing authority, a missing reconciliation seam, an unavailable provider, and a
# concurrent mismatch before task/model execution. Temporary compatibility rollback only:
# OSHAL_PUSH_ON_DISPATCH=off

# --- Trivy image scanner (Security Center 'image' scope; docs/runbooks/trivy-airgap-security-scanner.md) ---
# TRIVY_TICKET_SEVERITY_FLOOR=high    # severity at/above which a Trivy finding auto-files a backlog ticket
# TRIVY_CACHE_DIR=/app/data/trivy-cache   # pre-seeded OFFLINE vuln DB (air-gap); set by the image by default
# TRIVY_FS_TARGET=/app                # filesystem path scanned (defaults to SECURITY_SCAN_ROOT / /app)

# --- Spaces reconstruction box (ADR-111; scripts/spatial-recon-edge) ---
# The GPU-box video->3D-gaussian-splat service, reached over Tailscale. Set it and ?app=spaces
# reconstructs the REAL uploaded video; unset (default) falls back to the local Sim synthetic room.
# Deploy + protocol: scripts/spatial-recon-edge/README.md.
# RECON_URL=http://<gpu-box-tailscale-host>:8008
# Shared secret gating every box request (set the SAME value in the box's env). Recommended —
# without it the box trusts its network entirely (anyone reaching it can submit jobs / fetch scans).
# RECON_TOKEN=<long-random-string>

# ── Underwriting sources (intelligent-sales R3-01a) ──────────────────────────
# FMCSA (Motus/QCMobile) WebKey — free developer key: https://mobile.fmcsa.dot.gov/QCDevsite/
# (Login.gov under the business email). The admin paste in Underwriting → Integration keys
# outranks this env value.
FMCSA_WEBKEY=
# Carrier411 API credentials — STUB ONLY, not read by any code yet.
#CARRIER411_API_KEY=
#CARRIER411_API_SECRET=
