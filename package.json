    "k8:docker:installer:build": "bash scripts/build-any-bot-k8s-installer-image.sh",
    "k8:docker:installer:export": "bash scripts/build-any-bot-k8s-installer-image.sh --save",
    "gitlab:push-origins": "ts-node -r tsconfig-paths/register scripts/gitlab-origin-push.ts",
    "repo:sync": "ts-node -r tsconfig-paths/register scripts/gitlab-origin-push.ts",
    "verify:bots": "bash scripts/verify-bot-health.sh",
    "connectors:import-openapi": "ts-node -r tsconfig-paths/register --transpile-only scripts/connectors/import-openapi.ts",
    "connectors:import-openapi-catalog": "ts-node -r tsconfig-paths/register --transpile-only scripts/connectors/import-openapi-catalog.ts",
    "connectors:enrich-icons": "ts-node -r tsconfig-paths/register --transpile-only scripts/connectors/enrich-openapi-icons.ts",
    "connectors:assisted-onboarding": "ts-node -r tsconfig-paths/register --transpile-only scripts/connectors/assisted-provider-onboarding.ts",
    "provision:rls-role": "node scripts/governance/provision-rls-app-role.mjs",
    "verify:rls": "node scripts/governance/verify-rls-isolation.mjs",
    "verify:runtime-schema": "ts-node --project tsconfig.json -r tsconfig-paths/register scripts/governance/verify-runtime-schema-validate-only.ts",
    "evidence:competitive": "ts-node -r tsconfig-paths/register --transpile-only scripts/evidence/competitive-score-evidence.ts",
    "evidence:procurement-saas": "ts-node -r tsconfig-paths/register --transpile-only scripts/evidence/procurement-saas-readiness.ts",
    "evidence:refresh-local": "node scripts/evidence/refresh-local.mjs",
    "dev:session": "ts-node -r tsconfig-paths/register --transpile-only scripts/dev-session.ts",
    "dev:node": "ts-node -r tsconfig-paths/register --transpile-only scripts/dev-node.ts",
    "evidence:nightly": "node scripts/evidence/nightly-refresh.mjs",
    "provision:app-role": "node scripts/governance/provision-app-role.mjs",
    "connectors:curation-audit": "node scripts/connectors/curation-audit.mjs",
    "connectors:curate": "ts-node -r tsconfig-paths/register --transpile-only scripts/connectors/curate-catalog.ts",
    "connectors:audit-gate": "ts-node -r tsconfig-paths/register --transpile-only scripts/connectors/audit-gate.ts",
    "validate:manifests": "ts-node -r tsconfig-paths/register --transpile-only scripts/validate-manifests.ts",
    "gha:local": "ts-node -r tsconfig-paths/register --transpile-only scripts/gha-local.ts",
    "validate:doc-links": "bash scripts/validate-doc-links.sh",
    "build:exe": "node scripts/build-executable.js",
    "build:exe:all": "node scripts/build-executable.js --all",
    "build:exe:win": "node scripts/build-executable.js --windows",
    "build:exe:mac": "node scripts/build-executable.js --macos",
    "build:exe:linux": "node scripts/build-executable.js --linux",
    "google-workspace": "node scripts/google-workspace-cli.js",
    "test:google-workspace": "node tests/google-workspace-cli.test.js"
  },
