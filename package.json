{
  "name": "oshal-control-plane",
  "version": "2.1.0-beta.1",
  "description": "OSHAL — Open Swarm Harness Agent LLM. Docker-first multi-agent orchestration platform with pluggable harnesses (Cline, Codex, Claude Code, Gemini), per-bot persona quality gates, and a typed harness extension framework.",
  "license": "AGPL-3.0-or-later",
  "author": "oshal maintainers <maintainer@emeraldcoastsystemsgroup.com>",
  "homepage": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  },
  "main": "src/api/config-manager.ts",
  "bin": {
    "oshal-any-bot-k8s-setup": "./scripts/setup-any-bot-k8s-cli.js",
    "oshal-any-bot-local": "./scripts/any-bot-local-cli.js",
    "oshal-google-workspace": "./scripts/google-workspace-cli.js",
    "swarm-cli": "./packages/swarm-cli/bin/swarm-cli.js"
  },
  "scripts": {
    "start": "bash scripts/start-with-rag.sh",
    "start:local": "bash scripts/start-localhost.sh",
    "start:legacy": "node src/api/server.js",
    "start:static": "npx serve src/api -l 3456 --no-clipboard",
    "drone:node": "tsx src/app/drone-node-server.ts",
    "camera:node": "tsx src/app/camera-node-server.ts",
    "sat:node": "tsx src/app/sat-node-server.ts",
    "native:build": "node native/build.js",
    "native:check": "node native/build.js --check",
    "native:profile": "tsx native/bench/profile-ts.ts",
    "native:bench": "tsx native/bench/compare.ts",
    "native:parity": "tsx native/bench/parity.ts",
    "setup:facebook": "node scripts/facebook-app-setup.mjs",
    "setup:docker": "bash scripts/install-docker.sh",
    "docker:up": "bash scripts/run-docker.sh up",
    "docker:down": "bash scripts/run-docker.sh down",
    "docker:logs": "bash scripts/run-docker.sh logs",
    "test": "npx playwright test",
    "test:e2e:green": "node scripts/e2e-green.mjs",
    "test:unit": "vitest run",
    "test:ui": "npx playwright test --ui",
    "app": "node scripts/oshal-app.js",
    "test:live": "npx playwright test --config playwright.live.config.ts",
    "test:live:recheck": "npx playwright test --config playwright.live.config.ts tests/live/recheck-flagged.live.spec.ts",
    "test:live:deep": "npx playwright test --config playwright.live.config.ts tests/live/deep-features.live.spec.ts",
    "test:live:cockpit": "npx playwright test --config playwright.live.config.ts tests/live/cockpit-features.live.spec.ts",
    "test:live:walmart": "npx playwright test --config playwright.live.config.ts tests/live/walmart-drive-flow.live.spec.ts",
    "test:mock-oidc": "MOCK_OIDC=true PLAYWRIGHT_PORT=4458 PLAYWRIGHT_REUSE_SERVER=false npx playwright test",
    "test:mock-oidc:ui": "MOCK_OIDC=true PLAYWRIGHT_PORT=4458 PLAYWRIGHT_REUSE_SERVER=false npx playwright test --ui",
    "test:surfaces:docker": "node scripts/validate-app-surfaces-docker.mjs",
    "test:clickthrough:docker": "node scripts/validate-app-clickthrough-docker.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit --pretty false",
    "lint": "eslint src tests scripts",
    "lint:strict": "eslint src --max-warnings 0",
    "build:chat": "vite build --config vite.config.ts",
    "clean": "rm -rf ./config-output ./example-configs ./test-results ./playwright-report",
    "seed:tools": "ts-node -r tsconfig-paths/register scripts/seed-tools.ts",
    "provision:imported-bots": "ts-node -r tsconfig-paths/register scripts/provision-imported-bot-runtime.ts",
    "cleanup:runtime-state": "ts-node -r tsconfig-paths/register scripts/cleanup-runtime-state.ts",
    "repair:ticket-assignments": "ts-node -r tsconfig-paths/register scripts/operations/repair-ticket-assignments.ts",
    "repair:jarvis-task-lifecycle": "ts-node -r tsconfig-paths/register scripts/operations/repair-jarvis-task-lifecycle.ts",
    "benchmark:dynamic-insertion": "node scripts/dynamic-insertion-benchmark.mjs",
    "test:framework-contracts": "npx playwright test tests/dynamic-registration-framework.spec.ts tests/remote-client-framework.spec.ts tests/remote-client-live-mcp-e2e.spec.ts tests/workflow-runtime-boundary.spec.ts --reporter=line",
    "import:legacy-bots": "ts-node -r tsconfig-paths/register scripts/import-legacy-persona-bots.ts",
    "import:all-bots": "bash scripts/import-all-bots.sh",
    "swarm:ops": "bash scripts/swarm-runtime-control.sh",
    "local:any-bot": "node scripts/any-bot-local-cli.js",
    "local:start:any-bot": "node scripts/any-bot-local-cli.js start",
    "local:stop:any-bot": "node scripts/any-bot-local-cli.js stop",
    "local:status:any-bot": "node scripts/any-bot-local-cli.js status",
    "local:pack:any-bot": "node scripts/build-any-bot-local-package.js",
    "remote-client:start": "ts-node -r tsconfig-paths/register scripts/remote-client.ts",
    "edge-agent:start": "ts-node -r tsconfig-paths/register scripts/edge-agent.ts",
    "edge-agent:ui": "ts-node -r tsconfig-paths/register scripts/edge-agent-ui.ts",
    "local-agent": "bash scripts/start-local-agent.sh",
    "k8:setup:oshal": "bash scripts/setup-oshal-k8s.sh",
    "k8:install:oshal": "bash scripts/setup-oshal-k8s.sh",
    "k8:bootstrap": "bash scripts/install-k8s.sh",
    "k8:setup:any-bot": "node scripts/setup-any-bot-k8s-cli.js",
    "k8:install:any-bot": "node scripts/setup-any-bot-k8s-cli.js",
